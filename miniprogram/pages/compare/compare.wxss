.compare-table { background: #fff; border: 1rpx solid #e1e9e5; border-radius: 20rpx; overflow: hidden; margin-top: 26rpx; }
.compare-row { display: flex; align-items: stretch; border-bottom: 1rpx solid #edf1ee; padding: 14rpx 10rpx; }
.compare-row:last-child { border-bottom: 0; }
.row-label { width: 116rpx; flex-shrink: 0; display: flex; flex-direction: column; justify-content: center; padding-left: 10rpx; font-size: 25rpx; }
.compare-cell { flex: 1; min-width: 0; padding: 2rpx 6rpx; text-align: center; display: flex; align-items: center; justify-content: center; }
.compare-head { background: #edf5f0; padding-top: 22rpx; padding-bottom: 22rpx; font-size: 25rpx; font-weight: 600; }
.table-unit { font-size: 19rpx; color: #7c8b82; margin-top: 2rpx; }
.cell-grade { width: 100%; border-radius: 12rpx; padding: 10rpx 3rpx; }
.cell-number { font-size: 33rpx; font-weight: 650; line-height: 1.25; }
.cell-level { font-size: 21rpx; margin-top: 3rpx; }
.allergen-cell { font-size: 21rpx; color: #846453; }
.threshold-card { padding-top: 22rpx; padding-bottom: 22rpx; }
.threshold-line { display: flex; justify-content: space-between; font-size: 24rpx; margin-top: 9rpx; color: #586f61; }
