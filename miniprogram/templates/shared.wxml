<template name="footer">
  <view class="footer">
    <text class="footer-line">钠、糖、脂肪越高橙色越深；蛋白质越高橙色越浅</text>
    <text class="footer-line">依据 GB 28050-2025 含量声称条件</text>
    <text class="footer-line">仅供参考，不构成食品优劣评价</text>
  </view>
</template>
<template name="nutrients">
  <view class="nutrient-list">
    <view class="nutrient" wx:for="{{nutrients}}" wx:key="key">
      <text class="nutrient-name">{{item.label}}</text>
      <view class="nutrient-value">{{item.value}}<text class="unit">{{item.unit}}</text></view>
      <text wx:if="{{item.graded}}" class="grade {{item.depthClass}}">{{item.depthText}} · {{item.levelText}}</text>
    </view>
  </view>
</template>
<template name="legend">
  <view class="legend">
    <view class="legend-item"><view class="dot depth-light"></view>浅橙</view>
    <view class="legend-item"><view class="dot depth-mid"></view>中橙</view>
    <view class="legend-item"><view class="dot depth-deep"></view>深橙</view>
  </view>
  <view class="scale-note">钠、糖、脂肪越高橙色越深；蛋白质越高橙色越浅。</view>
  <view class="scale-note">依据 GB 28050-2025 含量声称条件</view>
  <view class="scale-note">仅供参考，不构成食品优劣评价</view>
</template>
<template name="jsonInput">
  <view class="card" wx:if="{{showInput}}">
    <view class="card-title">粘贴测试标签 JSON</view>
    <view class="muted">与扫码使用同一套解析。也可只粘贴 DEMO-0001 这样的编号。</view>
    <textarea class="input-box" value="{{jsonText}}" bindinput="onJsonInput" maxlength="4096" placeholder="粘贴 docs/qrcodes 内的 JSON，或样例编号" />
    <view class="input-error" wx:if="{{inputError}}">{{inputError}}</view>
    <button class="secondary" bindtap="submitJson">解析标签</button>
  </view>
</template>
<template name="samples">
  <view class="sample-grid">
    <button class="sample" wx:for="{{samples}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseSample">{{item.name}}</button>
  </view>
</template>
