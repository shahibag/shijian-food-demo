<import src="../../templates/shared.wxml" />
<view class="page">
  <view class="heading">先看完整标签</view>
  <view class="subtitle">扫测试二维码或点选样例后，首先进入完整标签信息。</view>
  <view class="actions">
    <button class="primary" bindtap="scan">扫一扫测试二维码</button>
    <button class="secondary" bindtap="toggleInput">粘贴 JSON</button>
  </view>
  <template is="jsonInput" data="{{showInput, jsonText, inputError}}" />
  <view class="card" wx:if="{{currentName}}">
    <view class="muted">最近查看</view>
    <view class="food-name">{{currentName}}</view>
    <view class="muted">{{source}}</view>
    <button class="secondary section-button" bindtap="reopenLabel">再次打开完整标签</button>
  </view>
  <view class="section">
    <view class="muted">15 条虚构样例都在本机。花生截图用花生酥糖，对照用纯牛奶，缺漏用原味燕麦片。</view>
    <template is="samples" data="{{samples: samples}}" />
  </view>
  <template is="footer" />
</view>
